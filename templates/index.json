    "custom_liquid_Bw3X8C": {
      "type": "custom-liquid",
      "name": "quikarmart-hero-section",
      "settings": {
        "custom_liquid": "<section id=\"quikrmart-hero\"\n  style='--hero-image: url(\"https://cdn.shopify.com/s/files/1/0726/8443/7601/files/heroimage.png?v=1792669903'>\n\n  <div class=\"quikrmart-hero__content\">\n\n    <p class=\"quikrmart-hero__eyebrow\">\n      WELCOME TO QUIKRMART\n    </p>\n\n    <h1 class=\"quikrmart-hero__title\">\n      <span class=\"blue\">Smart Finds.</span>\n      <span class=\"orange\">Better Everyday.</span>\n    </h1>\n\n    <p class=\"quikrmart-hero__description\">\n      Discover practical picks for your home and lifestyle.\n    </p>\n\n    <a class=\"quikrmart-hero__button\"\n       href=\"/collections/all\">\n      Shop Now <span aria-hidden=\"true\">→</span>\n    </a>\n\n  </div>\n</section>\n\n<style>\n  #quikrmart-hero,\n  #quikrmart-hero * {\n    box-sizing: border-box;\n  }\n\n  #quikrmart-hero {\n    width: 100vw;\n    margin-left: calc(50% - 50vw);\n    min-height: clamp(390px, 37vw, 560px);\n    display: flex;\n    align-items: center;\n    background-image: var(--hero-image);\n    background-size: cover;\n    background-position: center;\n    background-repeat: no-repeat;\n    overflow: hidden;\n  }\n\n  #quikrmart-hero .quikrmart-hero__content {\n    width: min(calc(100% - 48px), 1280px);\n    margin: 0 auto;\n    padding: 40px 0;\n  }\n\n  #quikrmart-hero .quikrmart-hero__eyebrow {\n    margin: 0 0 12px;\n    color: #0162EE;\n    font-family: var(--font-body-family, sans-serif);\n    font-size: 14px;\n    font-weight: 700;\n    letter-spacing: 0.06em;\n    text-transform: uppercase;\n  }\n\n  #quikrmart-hero .quikrmart-hero__title {\n    max-width: 680px;\n    margin: 0;\n    font-family: var(--font-heading-family, sans-serif);\n    font-size: clamp(42px, 4.5vw, 60px);\n    font-weight: 800;\n    line-height: 1.02;\n    letter-spacing: -0.035em;\n  }\n\n  #quikrmart-hero .blue,\n  #quikrmart-hero .orange {\n    display: block;\n  }\n\n  #quikrmart-hero .blue {\n    color: #0162EE;\n  }\n\n  #quikrmart-hero .orange {\n    color: #FEA503;\n  }\n\n  #quikrmart-hero .quikrmart-hero__description {\n    max-width: 570px;\n    margin: 16px 0 24px;\n    color: #102344;\n    font-family: var(--font-body-family, sans-serif);\n    font-size: clamp(16px, 1.5vw, 20px);\n    line-height: 1.5;\n  }\n\n  #quikrmart-hero .quikrmart-hero__button {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 10px;\n    padding: 15px 30px;\n    border-radius: 999px;\n    background: #FEA503;\n    color: #FFFFFF;\n    font-family: var(--font-body-family, sans-serif);\n    font-size: 16px;\n    font-weight: 700;\n    text-decoration: none;\n    transition: background 0.2s ease;\n  }\n\n  #quikrmart-hero .quikrmart-hero__button:hover {\n        background: rgb(var(--color-button-hover));\n  }\n\n  @media screen and (max-width: 749px) {\n    #quikrmart-hero {\n      min-height: 620px;\n      align-items: flex-start;\n      background-color: #F6F9FF;\n      background-size: auto 45%;\n      background-position: right bottom;\n    }\n\n    #quikrmart-hero .quikrmart-hero__content {\n      width: calc(100% - 36px);\n      margin: 0 18px;\n      padding: 38px 0 0;\n    }\n\n    #quikrmart-hero .quikrmart-hero__title {\n      font-size: clamp(38px, 9.5vw, 54px);\n      line-height: 1.04;\n      letter-spacing: -0.03em;\n    }\n\n    #quikrmart-hero .quikrmart-hero__description {\n      max-width: 350px;\n      margin: 14px 0 20px;\n      font-size: 16px;\n    }\n\n    #quikrmart-hero .quikrmart-hero__button {\n      padding: 13px 25px;\n    }\n  }\n</style>",
        "custom_class": ""
      }
