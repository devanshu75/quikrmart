
{% assign qrm_heading_blue = '#0162EE' %}
{% assign qrm_heading_orange = '#FEA503' %}

<section
  id="qrm-category-{{ section.id }}"
  class="qrm-category"
>
  <div class="qrm-category__inner">

    <div class="qrm-category__header">
      <div class="qrm-category__heading-wrap">
        <h2 class="qrm-category__heading">
          <span>{{ section.settings.heading_prefix | escape }}</span>
          <span class="qrm-category__accent">
            {{ section.settings.heading_accent | escape }}
          </span>
        </h2>

        {% if section.settings.subtitle != blank %}
          <p class="qrm-category__subtitle">
            {{ section.settings.subtitle | escape }}
          </p>
        {% endif %}
      </div>

      {% if section.settings.view_all_label != blank %}
        <a
          class="qrm-category__view-all"
          href="{{ section.settings.view_all_link | default: routes.all_products_collection_url }}"
        >
          {{ section.settings.view_all_label | escape }}
          {% comment %} <span aria-hidden="true">→</span> {% endcomment %}
        </a>
      {% endif %}
    </div>

    <div class="qrm-category__list">
      {% for block in section.blocks %}
        {% assign category_image = block.settings.image %}

        {% if category_image == blank and block.settings.collection != blank %}
          {% assign category_image = block.settings.collection.featured_image %}
        {% endif %}

        {% assign category_url = block.settings.custom_link %}

        {% if block.settings.collection != blank %}
          {% assign category_url = block.settings.collection.url %}
        {% endif %}

        <a
          href="{{ category_url | default: routes.all_products_collection_url }}"
          class="qrm-category__item"
          {{ block.shopify_attributes }}
        >
          <span
            class="qrm-category__circle qrm-category__circle--{{ block.settings.circle_style }}"
          >
            {% if category_image != blank %}
              {{
                category_image
                | image_url: width: 240
                | image_tag:
                  class: 'qrm-category__image',
                  widths: '80, 120, 160, 240',
                  sizes: '80px',
                  loading: 'lazy',
                  alt: block.settings.title
              }}
            {% elsif block.settings.title == 'More Categories' %}
              <svg
                class="qrm-category__more-icon"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
              >
                <rect x="3" y="3" width="7" height="7" rx="2"/>
                <rect x="14" y="3" width="7" height="7" rx="2"/>
                <rect x="3" y="14" width="7" height="7" rx="2"/>
                <rect x="14" y="14" width="7" height="7" rx="2"/>
              </svg>
            {% else %}
              {{ 'product-1' | placeholder_svg_tag: 'qrm-category__placeholder' }}
            {% endif %}
          </span>

          <span class="qrm-category__label">
            {{ block.settings.title | escape }}
          </span>
        </a>
      {% endfor %}
    </div>

  </div>
</section>

<style>
  #qrm-category-{{ section.id }} {
    --qrm-blue: {{ qrm_heading_blue }};
    --qrm-orange: {{ qrm_heading_orange }};
    --qrm-navy: #102344;
    --qrm-blue-circle: #E9F2FF;
    --qrm-orange-circle: #FFF0DC;
    --qrm-border: #E2EAF5;

    background: rgb(var(--color-background, 255, 255, 255));
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    color: var(--qrm-navy);
  }

  #qrm-category-{{ section.id }} *,
  #qrm-category-{{ section.id }} *::before,
  #qrm-category-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #qrm-category-{{ section.id }} .qrm-category__inner {
    width: min(100% - 48px, 1400px);
    margin-inline: auto;
  }

  #qrm-category-{{ section.id }} .qrm-category__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 20px;
    margin-bottom: 16px;
  }

  #qrm-category-{{ section.id }} .qrm-category__heading {
    margin: 0;
    color: var(--qrm-blue);
    font-family: var(--font-heading-family, sans-serif);
    font-size: clamp(21px, 2vw, 28px);
    font-weight: 750;
    letter-spacing: -0.035em;
    line-height: 1.2;
  }

  #qrm-category-{{ section.id }} .qrm-category__accent {
    color: var(--qrm-orange);
  }

  #qrm-category-{{ section.id }} .qrm-category__subtitle {
    margin: 3px 0 0;
    color: #52647F;
    font-family: var(--font-body-family, sans-serif);
    font-size: 16px;
    line-height: 1.5;
  }

  #qrm-category-{{ section.id }} .qrm-category__view-all {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 5px;
    color: var(--qrm-blue);
    font-family: var(--font-body-family, sans-serif);
    font-size: 12px;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }

  #qrm-category-{{ section.id }} .qrm-category__view-all:hover {
    color: var(--qrm-orange);
  }

  #qrm-category-{{ section.id }} .qrm-category__list {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 10px;
    align-items: start;
  }

  #qrm-category-{{ section.id }} .qrm-category__item {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: center;
    color: inherit;
    text-align: center;
    text-decoration: none;
    border-radius: 8px;
  }

  #qrm-category-{{ section.id }} .qrm-category__circle {
    width: clamp(52px, 5.5vw, 72px);
    aspect-ratio: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    overflow: hidden;
    margin-bottom: 8px;
    border-radius: 50%;
    transition: transform 180ms ease;
  }

  #qrm-category-{{ section.id }} .qrm-category__circle--blue {
    background: var(--qrm-blue-circle);
  }

  #qrm-category-{{ section.id }} .qrm-category__circle--orange {
    background: var(--qrm-orange-circle);
  }

  #qrm-category-{{ section.id }} .qrm-category__image {
    display: block;
    width: 88%;
    height: 88%;
    object-fit: contain;
  }

  #qrm-category-{{ section.id }} .qrm-category__more-icon {
    width: 25px;
    height: 25px;
    color: var(--qrm-blue);
  }

  #qrm-category-{{ section.id }} .qrm-category__placeholder {
    width: 80%;
    height: 80%;
    color: #9AA9BE;
  }

  #qrm-category-{{ section.id }} .qrm-category__label {
    max-width: 100%;
    color: var(--qrm-navy);
    font-family: var(--font-body-family, sans-serif);
    font-size: 11px;
    font-weight: 650;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }

  #qrm-category-{{ section.id }} .qrm-category__item:hover
  .qrm-category__circle {
    transform: translateY(-3px);
  }

  #qrm-category-{{ section.id }} .qrm-category__item:hover
  .qrm-category__label {
    color: var(--qrm-blue);
  }

  @media screen and (min-width: 750px) and (max-width: 1050px) {
    #qrm-category-{{ section.id }} .qrm-category__inner {
      width: calc(100% - 32px);
    }

    #qrm-category-{{ section.id }} .qrm-category__list {
      gap: 6px;
    }

    #qrm-category-{{ section.id }} .qrm-category__label {
      font-size: 10px;
    }
  }

  @media screen and (max-width: 749px) {
    #qrm-category-{{ section.id }} .qrm-category__inner {
      width: calc(100% - 32px);
    }

    #qrm-category-{{ section.id }} .qrm-category__header {
      gap: 12px;
      margin-bottom: 14px;
    }

    #qrm-category-{{ section.id }} .qrm-category__heading {
      font-size: 22px;
    }

    #qrm-category-{{ section.id }} .qrm-category__subtitle {
      font-size: 11px;
    }

    #qrm-category-{{ section.id }} .qrm-category__view-all {
      font-size: 10px;
    }

    #qrm-category-{{ section.id }} .qrm-category__list {
      display: flex;
      gap: 12px;
      overflow-x: auto;
      padding: 2px 1px 12px;
      scroll-snap-type: x proximity;
      scrollbar-width: thin;
    }

    #qrm-category-{{ section.id }} .qrm-category__item {
      flex: 0 0 72px;
      scroll-snap-align: start;
    }

    #qrm-category-{{ section.id }} .qrm-category__circle {
      width: 58px;
      margin-bottom: 7px;
    }

    #qrm-category-{{ section.id }} .qrm-category__label {
      font-size: 10px;
    }
  }
</style>

{% schema %}
{
  "name": "QUIKRMART category row",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "heading_prefix",
      "label": "Heading (blue)",
      "default": "Shop by"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading (orange)",
      "default": "Category"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Find what you need, all in one place."
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View all text",
      "default": "View All Categories"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View all link"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 16
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Category name",
          "default": "Home Essentials"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Category image"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Shopify collection"
        },
        {
          "type": "url",
          "id": "custom_link",
          "label": "Custom link (optional)"
        },
        {
          "type": "select",
          "id": "circle_style",
          "label": "Circle background",
          "options": [
            {
              "value": "blue",
              "label": "Light blue"
            },
            {
              "value": "orange",
              "label": "Light orange"
            }
          ],
          "default": "blue"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "QUIKRMART category row",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "title": "Home Essentials",
            "circle_style": "blue"
