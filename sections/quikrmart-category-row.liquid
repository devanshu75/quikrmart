          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Everyday Gadgets",
            "circle_style": "blue"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Health & Fitness",
            "circle_style": "orange"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Beauty & Personal Care",
            "circle_style": "orange"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Travel & Lifestyle",
            "circle_style": "blue"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Toys & Games",
            "circle_style": "orange"
          }
        },
        {
          "type": "category",
          "settings": {
