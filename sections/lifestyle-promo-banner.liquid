
{% liquid
  assign banner_image = section.settings.banner_image
  assign banner_heading = section.settings.heading
  assign banner_description = section.settings.description
  assign button_label = section.settings.button_label
  assign button_link = section.settings.button_link
%}

<section
  id="LifestyleBanner-{{ section.id }}"
  class="lifestyle-banner-section"
  style="
    --lb-background: {{ section.settings.background_color }};
    --lb-heading: {{ section.settings.heading_color }};
    --lb-text: {{ section.settings.text_color }};
    --lb-accent: {{ section.settings.accent_color }};
    --lb-button-text: {{ section.settings.button_text_color }};
    --lb-radius: {{ section.settings.corner_radius }}px;
  "
>
  <div class="lifestyle-banner">
    <div class="lifestyle-banner__image">
      {% if banner_image != blank %}
        {{
          banner_image
          | image_url: width: 1600
          | image_tag:
            widths: '375, 550, 750, 1000, 1300, 1600',
            sizes: '(min-width: 750px) 46vw, 100vw',
            loading: 'lazy',
            alt: banner_image.alt
        }}
      {% else %}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'lifestyle-banner__placeholder' }}
      {% endif %}
    </div>

    <div class="lifestyle-banner__content">
      <div class="lifestyle-banner__copy">
        {% if section.settings.eyebrow != blank %}
          <p class="lifestyle-banner__eyebrow">
            {{ section.settings.eyebrow | escape }}
          </p>
        {% endif %}

        {% if banner_heading != blank %}
          <h2 class="lifestyle-banner__heading">
            {{ banner_heading | escape }}
          </h2>
        {% endif %}

        {% if banner_description != blank %}
          <div class="lifestyle-banner__description">
            {{ banner_description }}
          </div>
        {% endif %}

        {% if button_label != blank %}
          {% if button_link != blank %}
            <a
              class="lifestyle-banner__button"
              href="{{ button_link }}"
              {% if section.settings.open_new_tab %}
                target="_blank" rel="noopener noreferrer"
              {% endif %}
            >
              <span>{{ button_label | escape }}</span>
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                aria-hidden="true"
              >
                <path
                  d="M5 12h14m-6-6 6 6-6 6"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </a>
          {% else %}
            <span class="lifestyle-banner__button">
              <span>{{ button_label | escape }}</span>
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                aria-hidden="true"
              >
                <path
                  d="M5 12h14m-6-6 6 6-6 6"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </span>
          {% endif %}
        {% endif %}
      </div>

      {% if section.settings.side_text != blank %}
        <div class="lifestyle-banner__side-text" aria-hidden="true">
          {{ section.settings.side_text | escape }}
        </div>
      {% endif %}
    </div>
  </div>
</section>

<style>
  #LifestyleBanner-{{ section.id }} {
    width: 100%;
    margin-top: {{ section.settings.margin_top }}px;
    margin-bottom: {{ section.settings.margin_bottom }}px;
    color: var(--lb-text);
  }

  #LifestyleBanner-{{ section.id }} .lifestyle-banner {
    display: grid;
    grid-template-columns: 50% 50%;
    min-height: {{ section.settings.banner_height }}px;
    overflow: hidden;
    position: relative;
    border-radius: var(--lb-radius);
    background: var(--lb-background);
    isolation: isolate;
  }

  #LifestyleBanner-{{ section.id }} .lifestyle-banner__image {
    position: relative;
    z-index: 1;
    min-width: 0;
    min-height: 100%;
    overflow: hidden;
    clip-path: polygon(0 0, 88% 0, 100% 100%, 0 100%);
    margin-right: -1px;
  }

  #LifestyleBanner-{{ section.id }} .lifestyle-banner__image img,
  #LifestyleBanner-{{ section.id }} .lifestyle-banner__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    min-height: {{ section.settings.banner_height }}px;
    object-fit: cover;
    object-position: {{ section.settings.image_position }};
    position: absolute;
    inset: 0;
  }

  #LifestyleBanner-{{ section.id }} .lifestyle-banner__content {
    min-width: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 22px 30px 22px 0;
  }

  #LifestyleBanner-{{ section.id }} .lifestyle-banner__copy {
    min-width: 0;
    flex: 1 1 auto;
  }

  #LifestyleBanner-{{ section.id }} .lifestyle-banner__eyebrow {
    margin: 0 0 7px;
    color: var(--lb-accent);
    font-size: 11px;
    line-height: 1.4;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  #LifestyleBanner-{{ section.id }} .lifestyle-banner__heading {
    margin: 0 0 7px;
    color: var(--lb-heading);
    font-size: clamp(23px, 2.2vw, 36px);
    font-weight: 750;
    line-height: 1.12;
    letter-spacing: -0.035em;
    overflow-wrap: anywhere;
  }

  #LifestyleBanner-{{ section.id }} .lifestyle-banner__description {
    color: var(--lb-text);
    font-size: 14px;
    line-height: 1.55;
  }

  #LifestyleBanner-{{ section.id }} .lifestyle-banner__description p {
    margin: 0;
  }

  #LifestyleBanner-{{ section.id }} .lifestyle-banner__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-top: 13px;
    padding: 11px 25px;
    border: 0;
    border-radius: 999px;
    background: var(--lb-accent);
    color: var(--lb-button-text);
    text-decoration: none;
    font: inherit;
    font-size: 13px;
    font-weight: 700;
    line-height: 1.3;
    cursor: pointer;
    transition: transform 180ms ease, filter 180ms ease;
  }

  #LifestyleBanner-{{ section.id }} .lifestyle-banner__button:hover {
    filter: brightness(0.96);
    transform: translateY(-2px);
  }

  #LifestyleBanner-{{ section.id }} .lifestyle-banner__button:focus-visible {
    outline: 2px solid var(--lb-heading);
    outline-offset: 4px;
  }

  #LifestyleBanner-{{ section.id }} .lifestyle-banner__side-text {
    flex: 0 0 95px;
    max-width: 105px;
    color: var(--lb-accent);
    font-size: 19px;
    line-height: 1.2;
    font-style: italic;
    font-weight: 600;
    text-align: center;
    transform: rotate(-5deg);
    white-space: pre-line;
  }

  @media screen and (min-width: 1500px) {
    #LifestyleBanner-{{ section.id }} .lifestyle-banner {
      max-width: 1600px;
      margin-inline: auto;
    }
  }

  @media screen and (max-width: 1000px) {
    #LifestyleBanner-{{ section.id }} .lifestyle-banner {
      grid-template-columns: 42% 58%;
    }

    #LifestyleBanner-{{ section.id }} .lifestyle-banner__content {
      padding-right: 20px;
      gap: 12px;
    }

    #LifestyleBanner-{{ section.id }} .lifestyle-banner__side-text {
      display: none;
    }
  }

  @media screen and (max-width: 749px) {
    #LifestyleBanner-{{ section.id }} {
      margin-top: {{ section.settings.mobile_margin_top }}px;
      margin-bottom: {{ section.settings.mobile_margin_bottom }}px;
    }

    #LifestyleBanner-{{ section.id }} .lifestyle-banner {
      grid-template-columns: 1fr;
      min-height: 0;
    }

    #LifestyleBanner-{{ section.id }} .lifestyle-banner__image {
      min-height: {{ section.settings.mobile_image_height }}px;
      clip-path: none;
      margin: 0;
    }

    #LifestyleBanner-{{ section.id }} .lifestyle-banner__image img,
    #LifestyleBanner-{{ section.id }} .lifestyle-banner__placeholder {
      min-height: {{ section.settings.mobile_image_height }}px;
    }

    #LifestyleBanner-{{ section.id }} .lifestyle-banner__content {
      padding: 22px 20px 24px;
    }

    #LifestyleBanner-{{ section.id }} .lifestyle-banner__heading {
      font-size: clamp(24px, 7vw, 32px);
    }

    #LifestyleBanner-{{ section.id }} .lifestyle-banner__description {
      font-size: 14px;
    }

    #LifestyleBanner-{{ section.id }} .lifestyle-banner__button {
      min-height: 44px;
      padding-inline: 22px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #LifestyleBanner-{{ section.id }} .lifestyle-banner__button {
      transition: none;
    }
  }
</style>

{% schema %}
{
  "name": "Lifestyle promo banner",
  "tag": "section",
  "class": "section-lifestyle-promo",
  "settings": [
    {
      "type": "header",
      "content": "Banner content"
    },
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Banner image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image focal point",
      "options": [
        { "value": "center center", "label": "Center" },
        { "value": "center top", "label": "Top" },
        { "value": "center bottom", "label": "Bottom" },
        { "value": "left center", "label": "Left" },
        { "value": "right center", "label": "Right" }
      ],
      "default": "center center"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small top text",
      "default": "YOUR LIFESTYLE, OUR PRODUCTS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main heading",
      "default": "Small Essentials. Big Differences."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Thoughtfully designed products for your home, travel and everyday life.</p>"
    },
    {
      "type": "text",
      "id": "side_text",
      "label": "Decorative side text",
      "default": "Explore More Everyday"
    },
    {
      "type": "header",
      "content": "Call-to-action button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button text",
      "default": "Shop Lifestyle Collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "checkbox",
      "id": "open_new_tab",
      "label": "Open link in a new tab",
      "default": false
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Banner background",
      "default": "#F0F6FF"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#0866F5"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Description color",
      "default": "#53657C"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent and button color",
      "default": "#FF9900"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "header",
      "content": "Desktop layout"
    },
    {
      "type": "range",
      "id": "banner_height",
      "label": "Banner height",
      "min": 120,
      "max": 360,
      "step": 10,
      "unit": "px",
      "default": 180
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Top spacing",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Mobile layout"
    },
    {
      "type": "range",
      "id": "mobile_image_height",
      "label": "Mobile image height",
      "min": 120,
      "max": 320,
      "step": 10,
      "unit": "px",
      "default": 190
    },
    {
      "type": "range",
      "id": "mobile_margin_top",
      "label": "Mobile top spacing",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "mobile_margin_bottom",
      "label": "Mobile bottom spacing",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 12
    }
  ],
  "presets": [
    {
      "name": "Lifestyle promo banner"
    }
  ]
}
{% endschema %}
